+// A ContactResponse under construction in slices, for hosts that solve on their audio thread: advance() runs
+// the contact integration for a bounded amount of work, a finished job becomes the response. The result is the
+// same as the response constructed at once.
+class ContactJob {
+    Key key_;
+    double velocity_;
+    std::vector<detail::StringModes> strings_;
+    detail::ContactState state_;
+    std::vector<double> force_;
+    std::array<std::vector<double>,3> string_force_;
+    long modes_ = 0;
+    friend class ContactResponse;
+public:
+    ContactJob(const Key& key, double velocity) : key_(key), velocity_(velocity) {
+        detail::validate_velocity(velocity);
+        velocity_ = std::clamp(velocity, .02, 1.0);
+        strings_ = detail::KeyAccess::strings(key_);
+        state_.v_h = key_.parameters().hammer.maximum_velocity_mps
+            * std::pow(velocity_, key_.parameters().hammer.velocity_exponent);
+        for (const auto& s : strings_) modes_ += s.n_modes;
+    }
+    bool done() const noexcept { return state_.done; }
+    // Integrates for about work mode-steps (one string mode advanced by one oversampled step), at least one
+    // step; returns the mode-steps spent. Allocates as the force records grow.
+    long advance(long work) {
+        if (state_.done) return 0;
+        long steps = std::max(1L, work / std::max(1L, modes_)), before = state_.step;
+        detail::step_contact(key_.parameters(), strings_, state_, force_, &string_force_, steps);
+        return (state_.step - before) * modes_;
+    }
+};
