 	static const Font getAldrichFont(float p_size) {
 #ifdef ODIN_MAC
 		p_size *= 0.81f; // for some reason the font is just larget on mac...
+#elif ODIN_WEBCLAP
+		// Odin's layout is sized for Windows, which measures fonts by their OS/2 win metrics. JUCE's HarfBuzz
+		// typefaces in the browser use hhea, like CoreText (hence the factor above). For Aldrich hhea ascent +
+		// descent is 1905 units, win 2458: the same pixel height draws the glyphs 2458 / 1905 times as large.
+		p_size *= 1905.0f / 2458.0f;
 #endif
 		static auto typeface_aldrich = Typeface::createSystemTypefaceFor(BinaryData::aldrich_regular_ttf, BinaryData::aldrich_regular_ttfSize);
 		return Font(typeface_aldrich).withHeight(p_size);
